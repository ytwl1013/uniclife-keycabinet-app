{
  "name": "uniclife-keycabinet-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "workspaces": [
    "admin",
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter @uniclife/backend --filter @uniclife/frontend dev",
    "dev:admin": "pnpm --filter @uniclife/admin dev",
    "dev:db": "docker compose -f deploy/docker/compose.dev.yml up -d --wait",
    "dev:db:down": "docker compose -f deploy/docker/compose.dev.yml down",
    "dev:db:logs": "docker compose -f deploy/docker/compose.dev.yml logs -f postgres",
    "dev:frontend": "pnpm --filter @uniclife/frontend dev",
    "dev:backend": "pnpm --filter @uniclife/backend dev",
    "db:migrate:dev": "pnpm --filter @uniclife/backend db:migrate:dev",
    "db:seed:dev": "pnpm --filter @uniclife/backend db:seed:dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  }
}
