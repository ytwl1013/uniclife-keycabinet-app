# Reference names and formats only. Configure real values in Render.
NODE_ENV=production
DATABASE_URL=postgres://<user>:<password>@<render-private-host>:5432/<database>
PORT=<render-provided-port>
HOST=0.0.0.0
LOG_LEVEL=info
FRONTEND_ORIGIN=https://<allowed-web-origin>
AUTH_TOKEN_PEPPER=<random-production-secret-at-least-32-characters>
AUTH_SESSION_TTL_DAYS=30
AUTH_RESET_TTL_MINUTES=10
AUTH_ALLOW_RESET_CODE_PREVIEW=false
