# Reference names and formats only. Configure real values in Render.
NODE_ENV=production
DATABASE_URL=postgres://<user>:<password>@<render-private-host>:5432/<database>
DB_POOL_MAX=5
PORT=<render-provided-port>
HOST=0.0.0.0
LOG_LEVEL=info
FRONTEND_ORIGIN=https://<allowed-web-origin>
ADMIN_API_TOKEN=<random-production-admin-service-token-at-least-32-characters>
AUTH_TOKEN_PEPPER=<random-production-secret-at-least-32-characters>
AUTH_SESSION_TTL_DAYS=30
AUTH_RESET_TTL_MINUTES=10
AUTH_ALLOW_RESET_CODE_PREVIEW=false
MAIL_SERVER=<smtp-host>
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=<smtp-account-email>
MAIL_PASSWORD=<render-secret>
MAIL_SENDER=<smtp-account-email>
MAIL_SENDER_NAME=keycabinet_app
MAIL_FEEDBACK_TO=<optional-feedback-recipient-defaults-to-mail-username>
MAIL_TIMEOUT=45
