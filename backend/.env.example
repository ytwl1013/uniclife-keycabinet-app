# Copy .env.development.example for local development.
# Configure production values in Render instead of committing a .env file.
NODE_ENV=<development-or-production>
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
PORT=<service-port>
HOST=<bind-host>
LOG_LEVEL=<log-level>
FRONTEND_ORIGIN=<allowed-web-origin>
AUTH_TOKEN_PEPPER=<random-secret-at-least-32-characters>
AUTH_SESSION_TTL_DAYS=<1-to-90>
AUTH_RESET_TTL_MINUTES=<5-to-60>
AUTH_ALLOW_RESET_CODE_PREVIEW=<true-or-false-development-only>
MAIL_SERVER=<smtp-host>
MAIL_PORT=<smtp-port>
MAIL_USE_SSL=<true-or-false>
MAIL_USE_TLS=<true-or-false>
MAIL_USERNAME=<smtp-account-email>
MAIL_PASSWORD=<smtp-password-or-app-password>
MAIL_SENDER=<sender-mailbox>
MAIL_SENDER_NAME=<sender-display-name>
MAIL_FEEDBACK_TO=<optional-feedback-recipient-defaults-to-mail-username>
MAIL_TIMEOUT=<seconds-1-to-120>
