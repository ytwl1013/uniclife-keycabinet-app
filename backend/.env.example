# Copy .env.development.example for local development.
# Configure production values in Render instead of committing a .env file.
NODE_ENV=<development-or-production>
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
PORT=<service-port>
HOST=<bind-host>
LOG_LEVEL=<log-level>
FRONTEND_ORIGIN=<allowed-web-origin>
