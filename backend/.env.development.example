# Local-only settings for deploy/docker/compose.dev.yml.
NODE_ENV=development
DATABASE_URL=postgres://keycabinet_dev@127.0.0.1:5432/keycabinet_dev
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
FRONTEND_ORIGIN=http://localhost:8081
AUTH_TOKEN_PEPPER=replace-with-a-local-random-string-at-least-32-characters
