# Local-only settings for deploy/docker/compose.dev.yml.
NODE_ENV=development
DATABASE_URL=postgres://keycabinet_dev@127.0.0.1:5432/keycabinet_dev
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
FRONTEND_ORIGIN=http://localhost:8081
AUTH_TOKEN_PEPPER=replace-with-a-local-random-string-at-least-32-characters
AUTH_SESSION_TTL_DAYS=30
AUTH_RESET_TTL_MINUTES=10
AUTH_ALLOW_RESET_CODE_PREVIEW=true

# Optional feedback SMTP. Keep secrets only in ignored .env.development.local or your shell.
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=465
# MAIL_USE_SSL=true
# MAIL_USE_TLS=false
# MAIL_USERNAME=feedback@example.com
# MAIL_PASSWORD=<smtp-app-password>
# MAIL_SENDER=keycabinet_app <feedback@example.com>
# MAIL_SENDER_NAME=keycabinet_app
# MAIL_FEEDBACK_TO=feedback@example.com
# MAIL_TIMEOUT=45
