{
  "expo": {
    "name": "UnicLife",
    "slug": "keycabinet-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/keycabinet_app_logo.png",
    "scheme": "uniclife-keycabinet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en-US",
          "en-GB",
          "de-DE",
          "fr-FR",
          "es-ES",
          "it-IT",
          "pt-PT",
          "nl-NL",
          "pl-PL"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.youliusteam.keycabinetapp"
    },
    "android": {
      "icon": "./src/assets/images/keycabinet_app_logo.png",
      "adaptiveIcon": {
        "backgroundColor": "#2F67F5",
        "foregroundImage": "./src/assets/images/keycabinet_app_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.youliusteam.keycabinetapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2F67F5",
          "defaultChannel": "support"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow UnicLife to scan a product QR code. Camera frames are not stored or uploaded by this app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow UnicLife to choose a profile photo. The selected photo is stored only on this device and is not uploaded.",
          "cameraPermission": "Allow UnicLife to scan a product QR code. Camera frames are not stored or uploaded by this app.",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en-US",
              "en-GB",
              "de-DE",
              "fr-FR",
              "es-ES",
              "it-IT",
              "pt-PT",
              "nl-NL",
              "pl-PL"
            ],
            "android": [
              "en",
              "de",
              "fr",
              "es",
              "it",
              "pt",
              "nl",
              "pl"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      "./plugins/with-required-camera-permission"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa160265-87d7-4d13-8ea8-c13bc69b6f26"
      }
    },
    "owner": "youlius-team"
  }
}
