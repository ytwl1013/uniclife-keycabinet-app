# Copy to .env.local and configure both URLs. The pnpm command selects dev or pro.
EXPO_PUBLIC_APP_ENV=dev
EXPO_PUBLIC_API_BASE_URL_DEV=http://192.168.1.100:4000/api/v1
EXPO_PUBLIC_API_BASE_URL_PRO=https://api.example.com/api/v1
EXPO_PUBLIC_EAS_PROJECT_ID=<eas-project-uuid>
EXPO_PUBLIC_SUPPORT_EMAIL=<public-support-email>
