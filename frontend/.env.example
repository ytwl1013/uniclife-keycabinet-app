# Copy .env.development.example to .env.local for local development.
# Configure production values in the EAS production environment.
EXPO_PUBLIC_APP_ENV=<development-or-production>
EXPO_PUBLIC_API_BASE_URL=<api-v1-base-url>
EXPO_PUBLIC_SUPPORT_EMAIL=<public-support-email>

# Optional production override; used only when EXPO_PUBLIC_APP_ENV=production.
EXPO_PUBLIC_API_BASE_URL_PRO=<https-api-v1-base-url>
