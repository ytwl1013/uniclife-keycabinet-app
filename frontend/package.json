{
  "name": "@uniclife/frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm start",
    "pro": "pnpm start:pro",
    "start": "EXPO_PUBLIC_APP_ENV=dev expo start --clear",
    "start:pro": "EXPO_PUBLIC_APP_ENV=pro expo start --clear",
    "android": "EXPO_LOCAL_ANDROID=1 EXPO_PUBLIC_APP_ENV=dev expo run:android --app-id com.youliusteam.keycabinetapp.debug",
    "android:pro": "EXPO_LOCAL_ANDROID=1 EXPO_PUBLIC_APP_ENV=pro expo run:android --app-id com.youliusteam.keycabinetapp.debug",
    "ios": "EXPO_PUBLIC_APP_ENV=dev expo start --clear --ios",
    "ios:pro": "EXPO_PUBLIC_APP_ENV=pro expo start --clear --ios",
    "web": "EXPO_PUBLIC_APP_ENV=dev expo start --clear --web",
    "web:pro": "EXPO_PUBLIC_APP_ENV=pro expo start --clear --web",
    "eas-build-post-install": "pnpm --filter @uniclife/shared build",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --no-watchman"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo/dom-webview": "~57.0.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "5.2.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@uniclife/shared": "workspace:*",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "heroui-native": "^1.0.6",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.4.0",
    "tailwind-variants": "3.2.2",
    "uniwind": "1.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/node": "^20.19.43",
    "@types/react": "~19.2.18",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest-expo": "^57.0.5",
    "prettier-plugin-tailwindcss": "0.5.11",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
