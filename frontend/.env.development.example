# Copy to .env.local and replace the address with this Mac's LAN IPv4 address.
# iOS Simulator can use localhost; a physical device must use the LAN address.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:4000/api/v1
# Optional fallback for a notification-enabled development build. `eas init` also embeds this ID.
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_SUPPORT_EMAIL=ytwl1013@gmail.com
