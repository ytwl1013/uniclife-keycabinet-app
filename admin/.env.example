# Copy to .env.local and replace every placeholder. Never commit that file.
APP_ENV=dev
API_BASE_URL_DEV=http://127.0.0.1:4000
API_BASE_URL_PRO=https://api.example.com

ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD_HASH=<generated-by-pnpm-generate-env-secrets>
ADMIN_SESSION_SECRET=<generated-by-pnpm-generate-env-secrets>
ADMIN_SESSION_TTL_HOURS=8

# DEV must match the local backend; PRO must match Render. Server-side only; never use NEXT_PUBLIC_*.
ADMIN_API_TOKEN_DEV=<generated-by-pnpm-generate-env-secrets>
ADMIN_API_TOKEN_PRO=<generated-by-pnpm-generate-env-secrets>
