# Copy to .env.local and replace every placeholder. Never commit that file.
APP_ENV=development
API_BASE_URL_DEVELOPMENT=http://127.0.0.1:4000
API_BASE_URL_DEV=https://dev-api.example.com

ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD_HASH=<generated-by-pnpm-generate-env-secrets>
ADMIN_SESSION_SECRET=<generated-by-pnpm-generate-env-secrets>
ADMIN_SESSION_TTL_HOURS=8

# Must exactly match backend ADMIN_API_TOKEN. Server-side only; never use NEXT_PUBLIC_*.
ADMIN_API_TOKEN=<generated-by-pnpm-generate-env-secrets>
